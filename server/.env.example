PORT=5000

# Yönetim paneli. Canlıda ikisi de ZORUNLU; SESSION_SECRET yoksa giriş kapalıdır.
ADMIN_PASSWORD=demo404
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=degistirin-uzun-rastgele-bir-dize

# Postgres. Yerel: infra/docker-compose.yml (postgres servisi). Canlı: Neon'un HAVUZLU (pooled) adresi.
# Tanımsızsa kayıtlar bellekte ve server/.data/store.json'da tutulur (yalnızca yerel demo için).
# DATABASE_URL=postgres://proje404:proje404yerel@localhost:5432/proje404

# Canlı Valhalla (infra/docker-compose.yml). Tanımsızsa kişisel planlar yaklaşık çizgiyle hesaplanır.
# VALHALLA_URL=http://localhost:8002
